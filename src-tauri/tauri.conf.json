{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SideBySide",
  "version": "0.1.0",
  "identifier": "com.bit92.sidebyside",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SideBySide by 92-bit",
        "width": 1200,
        "height": 760,
        "minWidth": 760,
        "minHeight": 480,
        "center": true,
        "decorations": false,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "92-bit",
    "copyright": "Copyright © 92-bit. Licensed under GPL-3.0.",
    "shortDescription": "Fast, lightweight side-by-side text comparison",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
